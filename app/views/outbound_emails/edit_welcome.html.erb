<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("helpers.page.welcome_email") %></h1>
    <p class="page-sub">This template is sent when a user account is created. Use {{name}}, {{email}}, {{password}}, {{role}}, {{clinic}} and {{login_url}}.</p>
  </div>
  <div class="page-actions">
    <%= link_to t("ui.back"), outbound_emails_path, class: "btn btn--ghost" %>
  </div>
</div>

<div class="mail-show">
  <section class="card form-card--wide">
    <%= form_with model: @setting, url: welcome_outbound_emails_path, method: :patch do |f| %>
      <%= render "shared/errors", resource: @setting %>
      <div class="field">
        <%= f.label :welcome_email_subject, "Subject", class: "field-label" %>
        <%= f.text_field :welcome_email_subject, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :welcome_email_html, "HTML body", class: "field-label" %>
        <%= f.text_area :welcome_email_html, class: "input", rows: 16 %>
      </div>
      <div class="form-actions">
        <%= f.submit t("ui.save"), class: "btn btn--primary" %>
        <%= link_to t("ui.cancel"), outbound_emails_path, class: "btn btn--ghost" %>
      </div>
    <% end %>
  </section>

  <section class="card mail-show-body">
    <h2 class="card-title">Preview</h2>
    <p class="page-sub" style="margin-bottom:12px"><%= @preview_subject %></p>
    <div class="email-html-preview"><%= sanitize(@preview_html, tags: %w[p br a strong em b i ol ul li h1 h2 h3 span div table tr td], attributes: %w[href style role width cellpadding cellspacing]) %></div>
  </section>
</div>
