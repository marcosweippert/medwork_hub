<%= form_with model: patient do |f| %>
  <%= render "shared/errors", resource: patient %>
  <div class="form-grid">
    <% if professional_user? %>
      <%= f.hidden_field :professional_id %>
    <% else %>
      <div class="field span-2">
        <%= f.label :professional_id, t("nav.professionals"), class: "field-label" %>
        <%= f.collection_select :professional_id, Professional.includes(:user), :id, :display_name, { include_blank: t("helpers.select_professional") }, class: "select" %>
      </div>
    <% end %>
    <div class="field"><%= f.label :name, t("patients.name"), class: "field-label" %><%= f.text_field :name, class: "input", required: true %></div>
    <div class="field"><%= f.label :contact, t("patients.contact"), class: "field-label" %><%= f.text_field :contact, class: "input", placeholder: t("patients.contact_placeholder") %></div>
    <div class="field span-2"><%= f.label :history, t("patients.history"), class: "field-label" %><%= f.text_area :history, class: "textarea", placeholder: t("patients.history_placeholder") %></div>
    <div class="span-2 form-actions">
      <%= f.submit class: "btn btn--primary" %>
      <%= link_to t("ui.cancel"), patients_path, class: "btn btn--ghost" %>
    </div>
  </div>
<% end %>
