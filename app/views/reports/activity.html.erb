<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("reports.activity") %></h1>
    <p class="page-sub"><%= @from.strftime("%d/%m/%Y") %> – <%= @to.strftime("%d/%m/%Y") %> · <%= @total %> events · <%= analytical? ? "analytical" : "synthetic" %></p>
  </div>
  <%= render "export" %>
</div>

<%= form_with url: activity_reports_path, method: :get, class: "filter-bar no-print" do %>
  <%= render "view_field" %>
  <div class="field">
    <label class="field-label">From</label>
    <%= date_field_tag :from, @from, class: "input" %>
  </div>
  <div class="field">
    <label class="field-label">To</label>
    <%= date_field_tag :to, @to, class: "input" %>
  </div>
  <%= submit_tag "Apply", class: "btn btn--ghost" %>
<% end %>

<% if analytical? %>
  <section class="card">
    <div class="card-head"><h2 class="card-title">Events</h2></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>When</th>
            <th>User</th>
            <th>Action</th>
            <th>Record</th>
          </tr>
        </thead>
        <tbody>
          <% Array(@events).each do |event| %>
            <tr>
              <td class="data-cell-mono"><%= event.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="cell-name"><%= event.actor_name %></td>
              <td><%= event.action.to_s.tr("._", " ") %></td>
              <td><%= event.record_name %></td>
            </tr>
          <% end %>
          <% if Array(@events).empty? %><tr><td colspan="4">No audit events in this range.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%= render "summary_head" %>
<section class="kpi-grid kpi-compact">
  <article class="kpi-card c-primary"><div class="kpi-label">Events</div><div class="kpi-value"><%= @total %></div></article>
  <article class="kpi-card"><div class="kpi-label">Today</div><div class="kpi-value"><%= @today %></div></article>
  <article class="kpi-card c-purple"><div class="kpi-label">Record types</div><div class="kpi-value"><%= @by_type.size %></div></article>
</section>

<div class="grid">
  <section class="col-6 card">
    <div class="card-head"><h2 class="card-title">Top actions</h2></div>
    <table class="table">
      <tbody>
        <% @by_action.each do |action, count| %>
          <tr><td class="cell-name"><%= action.to_s.tr("._", " ") %></td><td class="cell-num"><%= count %></td></tr>
        <% end %>
        <% if @by_action.empty? %><tr><td colspan="2">No audit events in this range.</td></tr><% end %>
      </tbody>
    </table>
  </section>
  <section class="col-6 card">
    <div class="card-head"><h2 class="card-title">By user</h2></div>
    <table class="table">
      <tbody>
        <% @by_user.each do |name, count| %>
          <tr><td class="cell-name"><%= name %></td><td class="cell-num"><%= count %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <section class="col-12 card">
    <div class="card-head"><h2 class="card-title">By record</h2></div>
    <table class="table">
      <tbody>
        <% @by_type.sort_by { |_, count| -count }.each do |type, count| %>
          <tr><td class="cell-name"><%= type.presence || "—" %></td><td class="cell-num"><%= count %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
