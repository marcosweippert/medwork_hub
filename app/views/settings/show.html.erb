<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("nav.settings") %></h1>
    <p class="page-sub"><%= t("settings.subtitle") %></p>
  </div>
</div>

<% if @setting.errors.any? %>
  <div class="alert alert-danger"><%= @setting.errors.full_messages.to_sentence %></div>
<% end %>

<div class="settings-shell">
  <nav class="settings-nav" aria-label="<%= t("nav.settings") %>">
    <%= link_to t("settings.clinic_nav"), settings_path(edit: "clinic"), class: (@edit_section.to_s == "clinic" ? "is-on" : nil) %>
    <%= link_to t("settings.policy_nav"), settings_path(edit: "policy"), class: (@edit_section.to_s == "policy" ? "is-on" : nil) %>
    <%= link_to t("settings.mail_nav"), settings_path(edit: "mail"), class: (@edit_section.to_s == "mail" ? "is-on" : nil) %>
    <%= link_to t("settings.pix_nav"), settings_path(edit: "pix"), class: (@edit_section.to_s == "pix" ? "is-on" : nil) %>
    <%= link_to t("settings.tickets_nav"), settings_path(edit: "tickets"), class: (@edit_section.to_s == "tickets" ? "is-on" : nil) %>
    <%= link_to t("nav.integrations"), integrations_path %>
    <%= link_to t("nav.api_keys"), api_keys_path %>
    <%= link_to t("nav.profile"), profile_path %>
  </nav>
  <div class="settings-panels">
    <%= render "settings/clinic_card" %>
    <%= render "settings/policy_card" %>
    <%= render "settings/mail_card" %>
    <%= render "settings/pix_card" %>
    <%= render "settings/tickets_card" %>
  </div>
</div>
