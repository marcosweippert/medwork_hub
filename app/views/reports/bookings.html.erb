<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("bookings.title") %></h1>
    <p class="page-sub"><%= @from.strftime("%d/%m/%Y") %> – <%= @to.strftime("%d/%m/%Y") %> · <%= @bookings.size %> records · <%= analytical? ? "analytical" : "synthetic" %></p>
  </div>
  <%= render "export" %>
</div>

<%= form_with url: bookings_reports_path, method: :get, class: "filter-bar no-print" do %>
  <%= render "view_field" %>
  <div class="field">
    <label class="field-label">From</label>
    <%= date_field_tag :from, @from, class: "input" %>
  </div>
  <div class="field">
    <label class="field-label">To</label>
    <%= date_field_tag :to, @to, class: "input" %>
  </div>
  <div class="field">
    <label class="field-label">Room</label>
    <%= select_tag :room_id, options_from_collection_for_select(@rooms, :id, :name, params[:room_id]), include_blank: t("ui.all_rooms"), class: "select" %>
  </div>
  <%= submit_tag "Apply", class: "btn btn--ghost" %>
<% end %>

<% if analytical? %>
  <section class="card">
    <div class="card-head"><h2 class="card-title">Records</h2></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Professional</th>
            <th>Room</th>
            <th>Start</th>
            <th>Type</th>
            <th>Status</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @bookings.limit(500).each do |booking| %>
            <tr>
              <td class="cell-name"><%= booking.professional.display_name %></td>
              <td><%= booking.room.name %></td>
              <td class="data-cell-mono"><%= booking.start_time&.strftime("%d/%m/%Y %H:%M") %></td>
              <td><%= booking.billing_type %></td>
              <td><%= status_tag(booking.status) %></td>
              <td class="cell-price"><%= number_to_currency(booking.amount) %></td>
            </tr>
          <% end %>
          <% if @bookings.empty? %><tr><td colspan="6">No bookings in this range.</td></tr><% end %>
        </tbody>
      </table>
    </div>
    <% if @bookings.size > 500 %>
      <p class="field-help" style="margin-top:10px;">Showing 500 of <%= @bookings.size %>. Export PDF or Excel for the full list.</p>
    <% end %>
  </section>
<% end %>

<%= render "summary_head" %>
<section class="kpi-grid">
  <% @by_status.each do |status, count| %>
    <article class="kpi-card">
      <div class="kpi-label"><%= status.to_s.titleize.presence || "Blank" %></div>
      <div class="kpi-value"><%= count %></div>
    </article>
  <% end %>
</section>

<div class="grid">
  <section class="col-6 card">
    <div class="card-head"><h2 class="card-title">By room</h2></div>
    <table class="table">
      <tbody>
        <% @by_room.sort_by { |_, count| -count }.each do |name, count| %>
          <tr><td class="cell-name"><%= name %></td><td class="cell-num"><%= count %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <section class="col-6 card">
    <div class="card-head"><h2 class="card-title">By type</h2></div>
    <table class="table">
      <tbody>
        <% @by_type.each do |type, count| %>
          <tr><td class="cell-name"><%= type.presence || "—" %></td><td class="cell-num"><%= count %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
