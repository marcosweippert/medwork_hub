<header class="d-topbar">
  <div class="crumbs">
    <button type="button" class="hamburger" data-action="sidebar#toggle" aria-label="<%= t("ui.menu") %>">
      <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" fill="none"/></svg>
    </button>
    <div>
      <div class="crumbs-label"><%= t("nav.workspace") %></div>
      <span class="current"><%= page_heading %></span>
    </div>
  </div>
  <div class="topbar-actions">
    <%= form_with url: invoices_path, method: :get, class: "hz-search" do %>
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
      <%= text_field_tag :q, params[:q], placeholder: t("dashboards.search_placeholder"), class: "hz-search-input" %>
    <% end %>
    <%= render "layouts/notifications" %>
    <%= link_to tickets_path, class: "icon-btn", title: t("nav.tickets") do %>
      <svg viewBox="0 0 24 24"><path d="M4 5h16v6a4 4 0 0 0 0 8v4H4v-4a4 4 0 0 0 0-8V5z"/><path d="M9 12h6"/></svg>
    <% end %>
    <button type="button" class="icon-btn" data-action="theme#toggle" aria-label="<%= t("ui.toggle_theme") %>">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <%= link_to profile_path, class: "hz-avatar", title: t("nav.profile") do %>
      <%= current_user&.initials || "MW" %>
    <% end %>
  </div>
</header>
