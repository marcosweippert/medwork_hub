<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Sign in · MedWork Hub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&display=swap">
    <script>
      (function () {
        try {
          var saved = localStorage.getItem("dash26-theme");
          document.documentElement.setAttribute("data-theme", saved || "light");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="session-body" data-controller="theme">
    <button type="button" class="icon-btn session-theme" data-action="theme#toggle" aria-label="Toggle theme">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <main class="auth-shell">
      <aside class="auth-aside">
        <div>
          <div class="auth-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/></svg>
          </div>
          <h1><%= @clinic_name %></h1>
          <p>Room scheduling, invoices and PIX checkout for the clinic team.</p>
          <ul class="auth-points">
            <li>Hold rooms and confirm occupancy</li>
            <li>Track overdue invoices in one place</li>
            <li>Pay, cancel or refund in bulk</li>
          </ul>
        </div>
        <p>Staff access only</p>
      </aside>
      <section class="auth-card">
        <%= render "shared/flash" %>
        <%= yield %>
      </section>
    </main>
  </body>
</html>
