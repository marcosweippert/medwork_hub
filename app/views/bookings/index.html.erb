<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("bookings.title") %></h1>
    <p class="page-sub"><%= t("bookings.subtitle") %></p>
  </div>
  <div class="page-actions">
    <%= link_to t("bookings.new"), new_booking_path, class: "btn btn--primary" %>
  </div>
</div>

<%= form_with url: bookings_path, method: :get, class: "filter-bar" do %>
  <div class="field field-grow">
    <label class="field-label"><%= t("ui.search") %></label>
    <%= text_field_tag :q, params[:q], class: "input", placeholder: t("bookings.search_placeholder") %>
  </div>
  <div class="field">
    <label class="field-label"><%= t("ui.when") %></label>
    <%= select_tag :when, options_for_select([[t("ui.all"), ""], [t("ui.today"), "today"], [t("ui.upcoming"), "upcoming"]], params[:when]), class: "select" %>
  </div>
  <div class="field">
    <label class="field-label"><%= t("ui.status") %></label>
    <%= select_tag :status, options_for_select([[t("ui.all"), ""]] + Booking::STATUSES.map { |s| [t("statuses.#{s}", default: s.humanize), s] }, params[:status]), class: "select" %>
  </div>
  <div class="field">
    <label class="field-label"><%= t("ui.room") %></label>
    <%= select_tag :room_id, options_from_collection_for_select(@rooms, :id, :name, params[:room_id]), include_blank: t("ui.all"), class: "select" %>
  </div>
  <%= submit_tag t("ui.filter"), class: "btn btn--ghost" %>
<% end %>

<section class="card">
  <div class="table-scroll">
    <table class="data-table data-table--booking-index">
      <colgroup>
        <col class="col-status">
        <col class="col-when">
        <col class="col-pro">
        <col class="col-room">
        <col class="col-type">
        <col class="col-money">
        <col class="col-invoice">
        <col class="col-actions">
      </colgroup>
      <thead>
        <tr>
          <th class="cell-status"><%= t("ui.status") %></th>
          <th class="cell-when"><%= t("ui.when") %></th>
          <th class="cell-name"><%= t("ui.professional") %></th>
          <th class="cell-room"><%= t("ui.room") %></th>
          <th class="cell-type"><%= t("bookings.type") %></th>
          <th class="cell-price"><%= t("bookings.amount") %></th>
          <th class="cell-invoice"><%= t("nav.invoices") %></th>
          <th class="cell-actions"><%= t("ui.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @bookings.each do |booking| %>
          <% amount = booking.billing_type == "monthly" && booking.invoice ? booking.invoice.amount : booking.amount %>
          <tr>
            <td class="cell-status"><%= status_tag(booking.status) %></td>
            <td class="cell-when data-cell-mono">
              <% if booking.start_time && booking.end_time %>
                <% if booking.start_time.to_date == booking.end_time.to_date %>
                  <%= booking.start_time.strftime("%d/%m") %>
                  <span class="cell-when-time"><%= booking.start_time.strftime("%H:%M") %>-<%= booking.end_time.strftime("%H:%M") %></span>
                <% else %>
                  <%= booking.start_time.strftime("%d/%m") %>-<%= booking.end_time.strftime("%d/%m") %>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="cell-name" title="<%= booking.professional.display_name %>"><%= booking.professional.display_name %></td>
            <td class="cell-room" title="<%= booking.room.name %>"><%= booking.room.name %></td>
            <td class="cell-type"><%= t("statuses.#{booking.billing_type}", default: booking.billing_type.to_s.humanize) %></td>
            <td class="cell-price"><%= number_to_currency(amount) %></td>
            <td class="cell-invoice">
              <% if booking.invoice %>
                <%= link_to "##{booking.invoice.id.to_s.rjust(4, "0")}", path_with_return(invoice_path(booking.invoice)), class: "table-link data-cell-mono" %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="cell-actions">
              <%= action_btn t("ui.open"), path_with_return(booking_path(booking)), tone: "view" %>
            </td>
          </tr>
        <% end %>
        <% if @bookings.empty? %>
          <tr><td colspan="8"><%= t("bookings.empty") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pager" %>
</section>
