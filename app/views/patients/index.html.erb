<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("patients.title") %></h1>
    <p class="page-sub"><%= professional_user? ? t("patients.subtitle_own") : t("patients.subtitle") %></p>
  </div>
  <div class="page-actions">
    <%= link_to t("patients.new"), new_patient_path, class: "btn btn--primary" %>
  </div>
</div>

<%= form_with url: patients_path, method: :get, class: "filter-bar" do %>
  <div class="field field-grow">
    <label class="field-label"><%= t("ui.search") %></label>
    <%= text_field_tag :q, params[:q], class: "input", placeholder: t("patients.search_placeholder") %>
  </div>
  <%= submit_tag t("ui.search"), class: "btn btn--ghost" %>
<% end %>

<section class="card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t("patients.name") %></th>
          <th><%= t("patients.contact") %></th>
          <% unless professional_user? %><th><%= t("nav.professionals") %></th><% end %>
          <th class="cell-actions"><%= t("ui.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @patients.each do |patient| %>
          <tr>
            <td class="cell-name"><%= patient.name %></td>
            <td><%= patient.contact %></td>
            <% unless professional_user? %><td><%= patient.professional.display_name %></td><% end %>
            <td class="cell-actions">
              <div class="row-actions">
                <%= action_btn t("ui.view"), patient, tone: "view" %>
                <%= action_btn t("ui.edit"), edit_patient_path(patient), tone: "edit" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pager" %>
</section>
