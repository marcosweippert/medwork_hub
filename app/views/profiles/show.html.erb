<div class="profile-hero">
  <span class="fb-avatar"><%= @user.initials %></span>
  <div>
    <h1 class="page-title" style="margin:0;"><%= @user.display_name %></h1>
    <p class="page-sub"><%= @user.email %> · <%= t("statuses.#{@user.role}", default: @user.role.to_s.humanize) %></p>
  </div>
</div>

<section class="card form-card">
  <h2 class="card-title"><%= t("profiles.title") %></h2>
  <p class="page-sub"><%= t("profiles.subtitle") %></p>
  <%= form_with model: @user, url: profile_path, method: :patch, class: "form-grid", style: "margin-top:16px;" do |f| %>
    <%= render "shared/errors", resource: @user %>
    <div class="field">
      <%= f.label :name, t("ui.name"), class: "field-label" %>
      <%= f.text_field :name, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :email, t("ui.email"), class: "field-label" %>
      <%= f.email_field :email, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :password, t("ui.password"), class: "field-label" %>
      <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
      <p class="field-help"><%= t("profiles.password_help") %></p>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, t("profiles.confirm"), class: "field-label" %>
      <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
    </div>
    <div class="span-2 form-actions">
      <%= f.submit t("ui.save"), class: "btn btn--primary" %>
    </div>
  <% end %>
</section>
