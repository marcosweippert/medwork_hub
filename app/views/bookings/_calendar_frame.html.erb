<%= turbo_frame_tag "booking_calendar" do %>
  <% if @selected_room && @calendar %>
    <div class="card-head" style="margin-top:4px;">
      <h2 class="card-title"><%= @selected_room.name %> · <%= @selected_room.types_label %></h2>
      <div class="page-actions">
        <%= link_to t("ui.prev"), calendar_bookings_path(room_id: @selected_room.id, professional_id: params[:professional_id], date: @date - 7), class: "btn btn--ghost btn--sm" %>
        <%= link_to t("ui.next"), calendar_bookings_path(room_id: @selected_room.id, professional_id: params[:professional_id], date: @date + 7), class: "btn btn--ghost btn--sm" %>
      </div>
    </div>
    <p class="field-help" style="margin:0 0 10px;">
      <%= number_to_currency(@selected_room.slot_price) %> / <%= Setting.current.slot_minutes %> min ·
      <%= format("%02d:00", @selected_room.opens_at) %>–<%= format("%02d:00", @selected_room.closes_at) %>
      <%= t("calendar.hours") %>
      <%= t("calendar.waitlist_hint", hours: clinic_policy[:free_hours]) %>
    </p>
    <%= render "rooms/slot_grid", calendar: @calendar, room: @selected_room %>
  <% else %>
    <p class="field-help" style="margin:8px 0;"><%= t("calendar.pick_room") %></p>
  <% end %>
<% end %>
