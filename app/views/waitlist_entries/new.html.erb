<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("helpers.heading.waitlist_entries.new") %></h1>
    <p class="page-sub"><%= @room.name %> · you will be notified if this slot opens</p>
  </div>
  <div class="page-actions">
    <%= link_to t("ui.calendar"), calendar_room_path(@room), class: "btn btn--ghost" %>
  </div>
</div>

<section class="card form-card">
  <%= form_with model: [@room, @entry] do |f| %>
    <%= render "shared/errors", resource: @entry %>
    <div class="form-grid">
      <div class="field">
        <%= f.label :professional_id, class: "field-label" %>
        <%= professional_field_tag "waitlist_entry[professional_id]", @professionals, selected: @entry.professional_id %>
      </div>
      <div class="field">
        <%= f.label :starts_at, class: "field-label" %>
        <%= f.datetime_local_field :starts_at, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :ends_at, class: "field-label" %>
        <%= f.datetime_local_field :ends_at, class: "input" %>
      </div>
      <div class="field span-2">
        <%= f.submit "Add to waitlist", class: "btn btn--primary" %>
      </div>
    </div>
  <% end %>
</section>
