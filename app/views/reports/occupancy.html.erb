<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("reports.occupancy") %></h1>
    <p class="page-sub">Week of <%= @week.strftime("%d/%m/%Y") %> · clinic average <%= @clinic_average %>% · <%= analytical? ? "analytical" : "synthetic" %></p>
  </div>
  <%= render "export" %>
</div>

<%= form_with url: occupancy_reports_path, method: :get, class: "filter-bar no-print" do %>
  <%= render "view_field" %>
  <div class="field">
    <label class="field-label">Week</label>
    <%= date_field_tag :week, @week, class: "input" %>
  </div>
  <div class="field">
    <label class="field-label">Room</label>
    <%= select_tag :room_id, options_from_collection_for_select(Room.order(:name), :id, :name, params[:room_id]), include_blank: t("ui.all_rooms"), class: "select" %>
  </div>
  <%= submit_tag "Apply", class: "btn btn--ghost" %>
  <%= link_to "Prev", occupancy_reports_path(week: @week - 7, room_id: params[:room_id], view: report_view), class: "btn btn--ghost" %>
  <%= link_to "Next", occupancy_reports_path(week: @week + 7, room_id: params[:room_id], view: report_view), class: "btn btn--ghost" %>
<% end %>

<% if analytical? %>
  <section class="card">
    <div class="card-head"><h2 class="card-title">Daily occupancy</h2></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Room</th>
            <th>Date</th>
            <th>Occupancy</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <% @days.each_with_index do |day, index| %>
              <% value = row[:daily][index] %>
              <% closed = row[:room].schedule_for(day).blank? %>
              <tr>
                <td class="cell-name"><%= row[:room].name %></td>
                <td class="data-cell-mono"><%= day.strftime("%a %d/%m/%Y") %></td>
                <td>
                  <% if closed %>
                    <span class="heat heat-0">—</span>
                  <% else %>
                    <span class="heat <%= occupancy_tone(value) %>"><%= value %>%</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
          <% if @rows.empty? %><tr><td colspan="3">No rooms.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%= render "summary_head" %>
<section class="card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Room</th>
          <% @days.each do |day| %>
            <th><%= day.strftime("%a %d") %></th>
          <% end %>
          <th>Avg</th>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr>
            <td class="cell-name"><%= row[:room].name %></td>
            <% row[:daily].each_with_index do |value, index| %>
              <% closed = row[:room].schedule_for(@days[index]).blank? %>
              <td>
                <% if closed %>
                  <span class="heat heat-0">—</span>
                <% else %>
                  <span class="heat <%= occupancy_tone(value) %>"><%= value %>%</span>
                <% end %>
              </td>
            <% end %>
            <td><span class="heat <%= occupancy_tone(row[:average]) %>"><%= row[:average] %>%</span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="field-help" style="margin-top:10px;">Green under 35% · amber 35–69% · red 70%+ · gray closed or empty</p>
</section>
