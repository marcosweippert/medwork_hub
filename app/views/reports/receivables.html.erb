<div class="page-head">
  <div>
    <h1 class="page-title">Receivables</h1>
    <p class="page-sub">Open <%= number_to_currency(@open_total, precision: 0) %> · overdue <%= number_to_currency(@overdue_total, precision: 0) %> · <%= analytical? ? "analytical" : "synthetic" %></p>
  </div>
  <%= render "export" %>
</div>

<%= form_with url: receivables_reports_path, method: :get, class: "filter-bar no-print" do %>
  <%= render "view_field" %>
  <div class="field">
    <label class="field-label">Professional</label>
    <%= select_tag :professional_id, options_from_collection_for_select(@professionals, :id, :display_name, params[:professional_id]), include_blank: "All", class: "select" %>
  </div>
  <%= submit_tag "Apply", class: "btn btn--ghost" %>
<% end %>

<% if analytical? %>
  <section class="card">
    <div class="card-head"><h2 class="card-title">Open</h2></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>Professional</th><th>Room</th><th>Amount</th><th>Due</th><th class="cell-actions no-print"></th></tr></thead>
        <tbody>
          <% @open.each do |invoice| %>
            <tr>
              <td class="cell-name"><%= link_to invoice.professional.display_name, path_with_return(invoice_path(invoice)), class: "table-link" %></td>
              <td><%= invoice.room&.name || "—" %></td>
              <td class="cell-price"><%= number_to_currency(invoice.amount) %></td>
              <td class="data-cell-mono"><%= invoice.due_date&.strftime("%d/%m/%Y") %></td>
              <td class="cell-actions no-print">
                <% if invoice.payable? %>
                  <div class="row-actions">
                    <%= action_btn "Pay", pay_invoice_path(invoice), tone: "pay", method: :patch, params: { return_to: originating_path } %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @open.empty? %><tr><td colspan="5">No open invoices.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" style="margin-top:12px;">
    <div class="card-head"><h2 class="card-title">Overdue</h2></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>Professional</th><th>Room</th><th>Amount</th><th>Due</th><th class="cell-actions no-print"></th></tr></thead>
        <tbody>
          <% @overdue.each do |invoice| %>
            <tr>
              <td class="cell-name"><%= link_to invoice.professional.display_name, path_with_return(invoice_path(invoice)), class: "table-link" %></td>
              <td><%= invoice.room&.name || "—" %></td>
              <td class="cell-price"><%= number_to_currency(invoice.amount) %></td>
              <td class="data-cell-mono"><%= invoice.due_date&.strftime("%d/%m/%Y") %></td>
              <td class="cell-actions no-print">
                <% if invoice.payable? %>
                  <div class="row-actions">
                    <%= action_btn "Pay", pay_invoice_path(invoice), tone: "pay", method: :patch, params: { return_to: originating_path } %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @overdue.empty? %><tr><td colspan="5">No overdue invoices.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%= render "summary_head" %>
<section class="kpi-grid kpi-compact">
  <article class="kpi-card c-primary">
    <div class="kpi-label">Open</div>
    <div class="kpi-value"><%= number_to_currency(@open_total, precision: 0) %></div>
    <div class="kpi-compare"><%= @open.size %> invoices</div>
  </article>
  <article class="kpi-card c-danger">
    <div class="kpi-label">Overdue</div>
    <div class="kpi-value"><%= number_to_currency(@overdue_total, precision: 0) %></div>
    <div class="kpi-compare"><%= @overdue.size %> invoices · new bookings blocked</div>
  </article>
</section>
