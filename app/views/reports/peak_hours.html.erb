<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("reports.peak_hours") %></h1>
    <p class="page-sub"><%= @from.strftime("%d/%m/%Y") %> – <%= @to.strftime("%d/%m/%Y") %> · <%= @total %> bookings · <%= analytical? ? "analytical" : "synthetic" %></p>
  </div>
  <%= render "export" %>
</div>

<%= form_with url: peak_hours_reports_path, method: :get, class: "filter-bar no-print" do %>
  <%= render "view_field" %>
  <div class="field">
    <label class="field-label">From</label>
    <%= date_field_tag :from, @from, class: "input" %>
  </div>
  <div class="field">
    <label class="field-label">To</label>
    <%= date_field_tag :to, @to, class: "input" %>
  </div>
  <div class="field">
    <label class="field-label">Room</label>
    <%= select_tag :room_id, options_from_collection_for_select(@rooms, :id, :name, params[:room_id]), include_blank: t("ui.all_rooms"), class: "select" %>
  </div>
  <%= submit_tag "Apply", class: "btn btn--ghost" %>
<% end %>

<% if analytical? %>
  <section class="card">
    <div class="card-head"><h2 class="card-title">Bookings</h2></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Professional</th>
            <th>Room</th>
            <th>Start</th>
            <th>Weekday</th>
            <th>Hour</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% Array(@detail_bookings).first(500).each do |booking| %>
            <tr>
              <td class="cell-name"><%= booking.professional.display_name %></td>
              <td><%= booking.room.name %></td>
              <td class="data-cell-mono"><%= booking.start_time&.strftime("%d/%m/%Y %H:%M") %></td>
              <td><%= booking.start_time&.strftime("%a") %></td>
              <td class="data-cell-mono"><%= booking.start_time&.strftime("%H:00") %></td>
              <td><%= status_tag(booking.status) %></td>
            </tr>
          <% end %>
          <% if Array(@detail_bookings).empty? %><tr><td colspan="6">No bookings in this range.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%= render "summary_head" %>
<section class="card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Day</th>
          <% @hours.each do |hour| %>
            <th><%= format("%02d", hour) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @dows.each do |dow| %>
          <tr>
            <td class="cell-name"><%= @dow_labels[dow] %></td>
            <% @hours.each do |hour| %>
              <% value = @grid[dow][hour] %>
              <td><span class="heat <%= volume_tone(value, @max) %>"><%= value.positive? ? value : "—" %></span></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="field-help" style="margin-top:10px;">Counts exclude cancelled bookings. Darker cells are busier relative to the busiest hour in the range.</p>
</section>
