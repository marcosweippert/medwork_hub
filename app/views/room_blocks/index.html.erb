<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("reports.blocks") %></h1>
    <p class="page-sub">Maintenance, holidays and clinic-wide closures</p>
  </div>
</div>

<section class="card" style="margin-bottom:12px;">
  <div class="card-head"><h2 class="card-title">New block</h2></div>
  <%= form_with model: @block, url: room_blocks_path, class: "form-grid" do |f| %>
    <div class="field">
      <%= f.label :room_id, class: "field-label" %>
      <%= f.collection_select :room_id, @rooms, :id, :name, { include_blank: t("ui.all_rooms") }, class: "select" %>
    </div>
    <div class="field">
      <%= f.label :starts_at, class: "field-label" %>
      <%= f.datetime_local_field :starts_at, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :ends_at, class: "field-label" %>
      <%= f.datetime_local_field :ends_at, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :reason, class: "field-label" %>
      <%= f.text_field :reason, class: "input", placeholder: "Holiday, maintenance…" %>
    </div>
    <div class="field span-2">
      <span class="field-label">Repeat weekly</span>
      <p class="field-help">Leave unchecked for a one-time block. Checked weekdays repeat the start/end hours every week.</p>
      <%= render "shared/weekday_checks", name: "room_block[weekdays]", selected: @block.weekdays %>
    </div>
    <div class="field span-2">
      <%= f.submit "Block period", class: "btn btn--primary" %>
    </div>
  <% end %>
</section>

<section class="card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Scope</th>
          <th>Start</th>
          <th>End</th>
          <th>Reason</th>
          <th class="cell-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @blocks.each do |block| %>
          <tr>
            <td class="cell-name"><%= block.room&.name || "All rooms" %></td>
            <td class="data-cell-mono">
              <% if block.recurring? %>
                <%= block.weekdays_label %> <%= block.starts_at.strftime("%H:%M") %>–<%= block.ends_at.strftime("%H:%M") %>
              <% else %>
                <%= block.starts_at.strftime("%d/%m/%Y %H:%M") %>
              <% end %>
            </td>
            <td class="data-cell-mono">
              <%= block.recurring? ? "weekly" : block.ends_at.strftime("%d/%m/%Y %H:%M") %>
            </td>
            <td><%= block.label %></td>
            <td class="cell-actions"><%= button_to "Remove", room_block_path(block), method: :delete, class: "btn btn--chip btn--danger" %></td>
          </tr>
        <% end %>
        <% if @blocks.empty? %><tr><td colspan="5">No blocks.</td></tr><% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pager" %>
</section>
