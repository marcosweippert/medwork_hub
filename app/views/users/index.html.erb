<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("users.title") %></h1>
    <p class="page-sub"><%= t("users.subtitle") %></p>
  </div>
  <div class="page-actions">
    <%= link_to t("users.new"), new_user_path, class: "btn btn--primary", data: { turbo: false } %>
  </div>
</div>

<%= form_with url: users_path, method: :get, class: "filter-bar" do %>
  <div class="field field-grow">
    <label class="field-label"><%= t("ui.search") %></label>
    <%= text_field_tag :q, params[:q], class: "input", placeholder: t("users.search_placeholder") %>
  </div>
  <%= submit_tag t("ui.search"), class: "btn btn--ghost" %>
<% end %>

<section class="card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t("ui.name") %></th>
          <th><%= t("ui.email") %></th>
          <th><%= t("ui.role") %></th>
          <th class="cell-actions"><%= t("ui.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="cell-name"><%= user.display_name %></td>
            <td class="data-cell-mono"><%= user.email %></td>
            <td><%= status_tag(user.role) %></td>
            <td class="cell-actions">
              <div class="row-actions">
                <%= action_btn t("ui.open"), user, tone: "view" %>
                <%= action_btn t("ui.edit"), edit_user_path(user), tone: "edit" %>
                <% if admin_user? && user != current_user %>
                  <%= action_btn t("ui.delete"), user, tone: "danger", method: :delete, confirm: t("users.confirm_delete") %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pager" %>
</section>
