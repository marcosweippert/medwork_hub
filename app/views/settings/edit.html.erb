<div class="page-head">
  <div>
    <h1 class="page-title">Edit settings</h1>
    <p class="page-sub">Clinic identity, PIX and reservation rules</p>
  </div>
  <div class="page-actions">
    <%= link_to "Back", settings_path, class: "btn btn--ghost" %>
  </div>
</div>

<section class="card form-card--wide">
  <%= form_with model: @setting, url: settings_path, method: :patch do |f| %>
    <%= render "shared/errors", resource: @setting %>
    <div class="form-grid">
      <div class="field">
        <%= f.label :clinic_name, class: "field-label" %>
        <%= f.text_field :clinic_name, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :clinic_email, class: "field-label" %>
        <%= f.email_field :clinic_email, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :clinic_phone, class: "field-label" %>
        <%= f.text_field :clinic_phone, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :currency, class: "field-label" %>
        <%= f.text_field :currency, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :slot_minutes, class: "field-label" %>
        <%= f.number_field :slot_minutes, min: 15, max: 120, step: 15, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :week_starts_on, class: "field-label" %>
        <%= f.select :week_starts_on, Setting::WEEK_STARTS.map { |day| [day.titleize, day] }, {}, class: "select" %>
      </div>
      <div class="field">
        <%= f.label :free_cancel_hours, class: "field-label" %>
        <%= f.number_field :free_cancel_hours, min: 0, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :late_cancel_percent, class: "field-label" %>
        <%= f.number_field :late_cancel_percent, min: 0, max: 100, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :started_cancel_percent, class: "field-label" %>
        <%= f.number_field :started_cancel_percent, min: 0, max: 100, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :pix_key, class: "field-label" %>
        <%= f.text_field :pix_key, class: "input", placeholder: "CPF, CNPJ, email, +5511999998888 or UUID" %>
        <p class="field-help">Use the exact DICT key: CPF/CNPJ digits only, phone as +55DDDNUMBER, email lowercase, or random key with hyphens.</p>
      </div>
      <div class="field">
        <%= f.label :pix_name, "PIX receiver name", class: "field-label" %>
        <%= f.text_field :pix_name, class: "input", maxlength: 25 %>
      </div>
      <div class="field">
        <%= f.label :pix_city, class: "field-label" %>
        <%= f.text_field :pix_city, class: "input", maxlength: 15, placeholder: "Sao Paulo" %>
      </div>
      <div class="field">
        <%= f.label :whatsapp_phone, class: "field-label" %>
        <%= f.text_field :whatsapp_phone, class: "input", placeholder: "11999998888" %>
      </div>
    </div>

    <h2 class="card-title" style="margin:18px 0 12px">Email delivery</h2>
    <p class="page-sub" style="margin-bottom:12px">Saved in the clinic settings and synced to the local .env file. The SMTP password is never shown.</p>
    <div class="form-grid">
      <div class="field">
        <%= f.label :smtp_address, "SMTP address", class: "field-label" %>
        <%= f.text_field :smtp_address, class: "input", placeholder: "smtp.gmail.com" %>
      </div>
      <div class="field">
        <%= f.label :smtp_port, class: "field-label" %>
        <%= f.number_field :smtp_port, class: "input", placeholder: "587" %>
      </div>
      <div class="field">
        <%= f.label :smtp_domain, class: "field-label" %>
        <%= f.text_field :smtp_domain, class: "input", placeholder: "gmail.com" %>
      </div>
      <div class="field">
        <%= f.label :smtp_username, class: "field-label" %>
        <%= f.text_field :smtp_username, class: "input", autocomplete: "off" %>
      </div>
      <div class="field">
        <%= f.label :smtp_password, "SMTP password", class: "field-label" %>
        <%= f.password_field :smtp_password, class: "input", value: "", autocomplete: "new-password", placeholder: @setting.smtp_password_set? ? "Saved — leave blank to keep" : "App password" %>
        <p class="field-help"><%= @setting.smtp_password_set? ? "A password is already saved. Fill this only to replace it." : "Use a Gmail app password, not the account password." %></p>
      </div>
      <div class="field">
        <%= f.label :smtp_authentication, class: "field-label" %>
        <%= f.select :smtp_authentication, [%w[Plain plain], %w[Login login], %w[CRAM-MD5 cram_md5]], {}, class: "select" %>
      </div>
      <div class="field">
        <%= f.label :mailer_from, "From address", class: "field-label" %>
        <%= f.email_field :mailer_from, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :mailer_host, "Links host", class: "field-label" %>
        <%= f.text_field :mailer_host, class: "input", placeholder: "localhost" %>
      </div>
      <div class="field">
        <%= f.label :mailer_port, "Links port", class: "field-label" %>
        <%= f.number_field :mailer_port, class: "input", placeholder: "3000" %>
      </div>
      <div class="field">
        <%= f.label :mailer_protocol, class: "field-label" %>
        <%= f.select :mailer_protocol, [%w[http http], %w[https https]], { include_blank: "Auto" }, class: "select" %>
      </div>
      <div class="field span-2">
        <label class="field-label">
          <%= f.check_box :smtp_enable_starttls %>
          Enable STARTTLS
        </label>
      </div>
      <div class="field span-2">
        <%= f.submit "Save settings", class: "btn btn--primary" %>
        <%= link_to "Cancel", settings_path, class: "btn btn--ghost" %>
      </div>
    </div>
  <% end %>
</section>
