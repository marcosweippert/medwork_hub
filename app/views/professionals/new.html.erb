<div class="page-head">
  <div>
    <h1 class="page-title">New professional</h1>
    <p class="page-sub">Creates the login and the professional profile together. A temporary password is emailed.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Back", professionals_path, class: "btn btn--ghost" %>
  </div>
</div>

<section class="card form-card">
  <%= form_with model: @user, url: professionals_path do |f| %>
    <%= render "shared/errors", resource: @user %>
    <div class="form-grid">
      <div class="field">
        <%= f.label :name, class: "field-label" %>
        <%= f.text_field :name, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, class: "input" %>
      </div>
      <div class="field span-2">
        <span class="field-label">Password</span>
        <p class="field-help">A temporary password is emailed. The professional must change it on first login.</p>
      </div>
      <%= f.fields_for :professional do |professional_fields| %>
        <%= render "shared/professional_fields", f: professional_fields %>
      <% end %>
      <div class="span-2 form-actions">
        <%= f.submit "Create professional", class: "btn btn--primary" %>
        <%= link_to "Cancel", professionals_path, class: "btn btn--ghost" %>
      </div>
    </div>
  <% end %>
</section>
