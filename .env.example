# Copy to .env and fill in local values. Never commit .env.

# SMTP (optional in development; without it, mail is written to tmp/mail)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_FROM=
MAILER_HOST=localhost
MAILER_PORT=3000
MAILER_PROTOCOL=http
MAILER_RAISE_ERRORS=true

# Production database
# MEDWORK_HUB_DATABASE_PASSWORD=
# SECRET_KEY_BASE=
