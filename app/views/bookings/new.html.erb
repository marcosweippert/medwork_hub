<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("bookings.new") %></h1>
    <p class="page-sub"><%= t("calendar.new_booking_help") %></p>
  </div>
  <div class="page-actions">
    <%= link_to t("ui.back"), back_path(bookings_path), class: "btn btn--ghost" %>
  </div>
</div>
<section class="card form-card--wide">

    <%= form_with url: bookings_path, method: :post, data: {
        controller: "booking-form slot-picker",
        slot_picker_minutes_value: Room.slot_minutes,
        booking_form_calendar_url_value: calendar_bookings_path,
        booking_form_empty_value: t("calendar.pick_room")
      } do %>
    <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
    <%= hidden_field_tag :billing_type, "hourly" %>
    <input type="hidden" data-slot-picker-target="hourlyRate" value="0">

    <%= render "shared/errors", resource: @booking if @booking&.errors&.any? %>

    <div class="form-grid">
      <div class="field">
        <label class="field-label"><%= t("calendar.professional") %></label>
        <%= professional_field_tag "booking[professional_id]", @professionals, selected: @booking.professional_id,
              html: { data: { booking_form_target: "professional", action: "change->booking-form#professionalChanged" } } %>
      </div>
      <div class="field">
        <label class="field-label"><%= t("ui.room") %></label>
        <%= select_tag "booking[room_id]",
              room_options(@rooms, selected: @booking.room_id),
              class: "select",
              data: { booking_form_target: "room", action: "change->booking-form#roomChanged" } %>
      </div>
      <div class="field">
        <label class="field-label"><%= t("calendar.repeat_weekly") %></label>
        <%= select_tag :weeks, options_for_select([[t("calendar.this_week"), 1]] + (2..12).map { |n| [t("calendar.weeks", count: n), n] }, params[:weeks] || 1), class: "select" %>
      </div>
      <div class="field">
        <label class="field-label"><%= t("ui.selection") %></label>
        <div class="field-help">
          <span data-slot-picker-target="count">0</span> × <%= Setting.current.slot_minutes %> min · R$
          <span data-slot-picker-target="total">0,00</span>
        </div>
      </div>
    </div>

    <div class="legend" style="margin-top:12px;">
      <span><i class="free"></i><%= t("ui.available") %></span>
      <span><i class="reserved"></i><%= t("ui.reserved") %></span>
      <span><i class="occupied"></i><%= t("ui.occupied") %></span>
      <span><i class="blocked"></i><%= t("ui.blocked") %></span>
      <span><i class="closed"></i><%= t("ui.closed") %></span>
    </div>

    <%= render "calendar_frame" %>

    <div class="page-actions" style="margin-top:14px;">
      <%= submit_tag t("calendar.reserve_hours"), class: "btn btn--primary" %>
      <%= link_to t("ui.cancel"), back_path(bookings_path), class: "btn btn--ghost", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
</section>
