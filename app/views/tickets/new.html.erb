<nav class="fb-crumb" aria-label="breadcrumb">
  <%= link_to t("nav.dashboard"), root_path %>
  <span>›</span>
  <%= link_to t("nav.tickets"), tickets_path %>
  <span>›</span>
  <span class="is-current"><%= t("tickets.create") %></span>
</nav>
<div class="ticket-hero">
  <div>
    <%= link_to t("ui.back"), tickets_path, class: "ticket-back" %>
    <h1 class="page-title"><%= t("tickets.create") %></h1>
    <p class="page-sub"><%= Setting.current.ticket_sla_policy %></p>
  </div>
</div>

<section class="card form-card">
  <%= form_with model: @ticket do |f| %>
    <% if @ticket.errors.any? %>
      <div class="alert alert-danger"><%= @ticket.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="field">
      <%= f.label :subject, t("tickets.subject"), class: "field-label" %>
      <%= f.text_field :subject, class: "input", placeholder: t("tickets.subject_placeholder") %>
    </div>
    <div class="form-grid" style="margin-top:12px;">
      <div class="field">
        <%= f.label :category, t("tickets.category"), class: "field-label" %>
        <%= f.select :category, ticket_category_options, {}, class: "select" %>
      </div>
      <div class="field">
        <%= f.label :priority, t("tickets.priority"), class: "field-label" %>
        <%= f.select :priority, ticket_priority_options, {}, class: "select" %>
      </div>
    </div>
    <div class="field" style="margin-top:12px;">
      <%= f.label :body, t("tickets.body"), class: "field-label" %>
      <%= f.text_area :body, class: "input", rows: 7, placeholder: t("tickets.body_placeholder") %>
    </div>
    <div class="form-actions" style="margin-top:16px;">
      <%= f.submit t("tickets.submit"), class: "btn btn--primary" %>
      <%= link_to t("ui.cancel"), tickets_path, class: "btn btn--ghost" %>
    </div>
  <% end %>
</section>
