<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("emails.inbox") %></h1>
    <p class="page-sub"><%= t("nav.emails") %></p>
  </div>
  <div class="page-actions">
    <%= link_to t("emails.welcome"), edit_welcome_outbound_emails_path, class: "btn btn--ghost" %>
    <%= link_to t("emails.compose"), new_outbound_email_path, class: "btn btn--primary" %>
  </div>
</div>

<div class="inbox-layout">
  <aside class="inbox-side">
    <strong style="font-size:13px;"><%= t("emails.folders") %></strong>
    <%= link_to t("emails.all"), outbound_emails_path, class: (params[:status].blank? ? "is-on" : nil) %>
    <%= link_to t("emails.sent"), outbound_emails_path(status: "sent"), class: (params[:status] == "sent" ? "is-on" : nil) %>
    <%= link_to t("emails.failed"), outbound_emails_path(status: "failed"), class: (params[:status] == "failed" ? "is-on" : nil) %>
    <%= link_to t("emails.bounced"), outbound_emails_path(status: "bounced"), class: (params[:status] == "bounced" ? "is-on" : nil) %>
  </aside>

  <div>
    <%= form_with url: outbound_emails_path, method: :get, class: "filter-bar" do %>
      <div class="field field-grow">
        <label class="field-label"><%= t("ui.search") %></label>
        <%= text_field_tag :q, params[:q], class: "input", placeholder: "#{t("emails.to")}, #{t("emails.subject")}" %>
      </div>
      <div class="field">
        <label class="field-label"><%= t("ui.status") %></label>
        <%= filter_select :status, [[t("emails.sent"), "sent"], [t("emails.failed"), "failed"], [t("emails.bounced"), "bounced"]], selected: params[:status] %>
      </div>
      <div class="field">
        <label class="field-label"><%= t("emails.kind") %></label>
        <%= filter_select :kind, @kinds.map { |kind| [kind.to_s.humanize, kind] }, selected: params[:kind] %>
      </div>
      <%= submit_tag t("ui.search"), class: "btn btn--ghost" %>
    <% end %>

    <%= form_with url: bulk_outbound_emails_path, method: :post, data: { controller: "bulk-select" } do %>
      <div class="bulk-bar" data-bulk-select-target="bar" hidden>
        <strong data-bulk-select-target="count">0 selected</strong>
        <div class="page-actions">
          <%= button_tag t("emails.resend"), name: "bulk_action", value: "resend", class: "btn btn--primary btn--sm", data: { turbo_confirm: t("emails.resend") } %>
          <%= button_tag t("emails.delete"), name: "bulk_action", value: "delete", class: "btn btn--ghost btn--sm" %>
        </div>
      </div>

      <section class="card">
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>
                  <input type="checkbox" class="row-check" data-bulk-select-target="all" data-action="change->bulk-select#toggleAll" aria-label="<%= t("ui.all") %>">
                </th>
                <th><%= t("emails.when") %></th>
                <th><%= t("emails.to") %></th>
                <th><%= t("emails.subject") %></th>
                <th><%= t("emails.kind") %></th>
                <th><%= t("ui.status") %></th>
                <th class="cell-actions"><%= t("ui.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% @emails.each do |email| %>
                <tr>
                  <td>
                    <%= check_box_tag "email_ids[]", email.id, false, class: "row-check", id: "email_#{email.id}", data: { bulk_select_target: "row", action: "change->bulk-select#refresh" } %>
                  </td>
                  <td class="data-cell-mono"><%= email.sent_at&.strftime("%d/%m/%Y %H:%M") %></td>
                  <td><%= email.to_address %></td>
                  <td><%= link_to email.subject.presence || t("emails.untitled"), outbound_email_path(email), class: "table-link" %></td>
                  <td><%= email.kind_label %></td>
                  <td><%= status_tag(email.status) %></td>
                  <td class="row-actions">
                    <%= link_to t("emails.open"), outbound_email_path(email), class: "btn btn--chip" %>
                  </td>
                </tr>
              <% end %>
              <% if @emails.empty? %>
                <tr><td colspan="7"><%= t("emails.empty") %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "shared/pager" %>
      </section>
    <% end %>
  </div>
</div>
