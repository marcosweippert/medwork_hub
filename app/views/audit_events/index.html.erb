<div class="page-head">
  <div>
    <h1 class="page-title">Audit log</h1>
    <p class="page-sub"><%= @stats[:total] %> events · <%= @stats[:today] %> today · <%= @stats[:updates] %> updates · <%= @stats[:deletes] %> deletes</p>
  </div>
  <div class="page-actions">
    <%= link_to "Export CSV", export_audit_events_path(request.query_parameters), class: "btn btn--ghost" %>
  </div>
</div>

<%= form_with url: audit_events_path, method: :get, class: "filter-bar" do %>
  <div class="field field-grow">
    <label class="field-label">Search</label>
    <%= text_field_tag :q, params[:q], class: "input", placeholder: "Action, user, record or details" %>
  </div>
  <div class="field">
    <label class="field-label">Action</label>
    <%= filter_select :action_name, @actions.map { |action| [action.tr("._", " "), action] }, selected: params[:action_name] %>
  </div>
  <div class="field">
    <label class="field-label">Record</label>
    <%= filter_select :record_type, @record_types.map { |type| [type, type] }, selected: params[:record_type] %>
  </div>
  <div class="field">
    <label class="field-label">User</label>
    <%= select_tag :user_id, options_from_collection_for_select(@users, :id, :display_name, params[:user_id]), include_blank: "All", class: "select" %>
  </div>
  <div class="field">
    <label class="field-label">From</label>
    <%= date_field_tag :from, params[:from], class: "input" %>
  </div>
  <div class="field">
    <label class="field-label">To</label>
    <%= date_field_tag :to, params[:to], class: "input" %>
  </div>
  <%= submit_tag "Search", class: "btn btn--ghost" %>
<% end %>

<%= form_with url: bulk_audit_events_path, method: :post, data: { controller: "bulk-select" } do %>
  <div class="bulk-bar" data-bulk-select-target="bar" hidden>
    <strong data-bulk-select-target="count">0 selected</strong>
    <span class="field-help">Delete only removes log rows, not the clinic records.</span>
    <div class="page-actions">
      <%= button_tag "Delete", name: "bulk_action", value: "delete", class: "btn btn--ghost btn--sm", data: { turbo_confirm: "Remove the selected audit events?" } %>
    </div>
  </div>

  <section class="card">
    <div class="email-board-head">
      <label class="cell-check">
        <input type="checkbox" class="row-check" data-bulk-select-target="all" data-action="change->bulk-select#toggleAll" aria-label="Select all events">
      </label>
      <span>When</span>
      <span>User</span>
      <span>Action</span>
      <span>Record</span>
      <span>Status</span>
      <span class="email-board-actions-label">Actions</span>
    </div>
    <% @events.each do |event| %>
      <article class="email-item" data-email-item data-controller="email-preview">
        <div class="email-item-row audit-item-row">
          <div class="cell-check">
            <%= check_box_tag "event_ids[]", event.id, false, class: "row-check", id: "event_#{event.id}", data: { bulk_select_target: "row", action: "change->bulk-select#refresh" }, aria: { label: "Select event #{event.id}" } %>
          </div>
          <div class="data-cell-mono"><%= event.created_at.strftime("%d/%m/%Y %H:%M") %></div>
          <div class="email-item-subject"><%= event.actor_name %></div>
          <div class="email-item-subject" title="<%= event.action %>"><%= event.action.tr("._", " ") %></div>
          <div class="email-item-to"><%= event.record_name %></div>
          <div><%= status_tag(event.verb) %></div>
          <div class="row-actions">
            <button type="button" class="btn btn--chip btn--view" data-email-preview-target="button" data-action="email-preview#toggle">Details</button>
            <%= action_btn "Open", audit_event_path(event), tone: "edit" %>
            <% if (path = auditable_path_for(event)) %>
              <%= action_btn "Record", path, tone: "cal" %>
            <% end %>
            <%= action_btn "Delete", audit_event_path(event), tone: "danger", method: :delete, confirm: "Remove this event from the log?" %>
          </div>
        </div>
        <div class="email-item-preview" hidden data-email-preview-target="panel">
          <pre class="email-text"><%= JSON.pretty_generate(event.parsed_details) %></pre>
        </div>
      </article>
    <% end %>
    <% if @events.empty? %>
      <p class="page-sub" style="padding:14px">No events yet.</p>
    <% end %>
    <%= render "shared/pager" %>
  </section>
<% end %>
