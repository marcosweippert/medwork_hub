<% if @total_count.to_i.positive? %>
  <div class="index-meta">
    <span>
      <%= t("ui.records", count: @total_count) %>
      <% if @total_pages.to_i > 1 %> · <%= t("ui.page_of", page: @page, pages: @total_pages) %><% end %>
    </span>
    <% if @total_pages.to_i > 1 %>
      <div class="pager">
        <% query = request.query_parameters.except("page") %>
        <%= link_to t("ui.prev"), url_for(query.merge(page: @page - 1)), class: "pager-btn" if @page > 1 %>
        <%= link_to t("ui.next"), url_for(query.merge(page: @page + 1)), class: "pager-btn" if @page < @total_pages %>
      </div>
    <% end %>
  </div>
<% end %>
