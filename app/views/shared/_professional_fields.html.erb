<% professional = f.object %>
<div class="field span-2">
  <span class="field-label"><%= t("professionals.practice_area") %></span>
  <p class="field-help"><%= t("professionals.practice_area_help") %></p>
  <%= hidden_field_tag "#{f.object_name}[practice_areas][]", "" %>
  <div class="choice-grid">
    <% PracticeArea::AREAS.each do |key, config| %>
      <label class="check">
        <%= check_box_tag "#{f.object_name}[practice_areas][]", key, Array(professional.practice_areas).include?(key), id: "#{f.object_name.to_s.parameterize}_practice_area_#{key}" %>
        <span class="box"></span>
        <%= config[:label] %>
      </label>
    <% end %>
  </div>
</div>
<div class="field">
  <%= f.label :specialty, t("professionals.specialty"), class: "field-label" %>
  <%= f.text_field :specialty, class: "input", placeholder: t("professionals.specialty_placeholder") %>
</div>
<div class="field">
  <%= f.label :license_number, class: "field-label" %>
  <%= f.text_field :license_number, class: "input" %>
</div>
<div class="field">
  <%= f.label :phone, t("professionals.phone"), class: "field-label" %>
  <%= f.text_field :phone, class: "input", placeholder: "11999998888" %>
</div>
<div class="field span-2">
  <%= f.label :bio, class: "field-label" %>
  <%= f.text_area :bio, class: "textarea", placeholder: t("professionals.bio_placeholder") %>
</div>
