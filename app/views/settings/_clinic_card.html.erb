<section class="col-6 card <%= "is-editing" if settings_editing?("clinic") %>">
  <div class="card-head">
    <h2 class="card-title"><%= t("settings.clinic.title") %></h2>
    <% unless settings_editing?("clinic") %>
      <%= link_to t("ui.edit"), settings_path(edit: "clinic"), class: "btn btn--ghost btn--sm" %>
    <% end %>
  </div>
  <% if settings_editing?("clinic") %>
    <%= form_with model: @setting, url: settings_path, method: :patch, class: "form-grid", multipart: true do |f| %>
      <%= hidden_field_tag :section, "clinic" %>
      <div class="field"><%= f.label :clinic_name, t("settings.clinic.name"), class: "field-label" %><%= f.text_field :clinic_name, class: "input" %></div>
      <div class="field"><%= f.label :clinic_email, t("settings.clinic.email"), class: "field-label" %><%= f.email_field :clinic_email, class: "input" %></div>
      <div class="field"><%= f.label :clinic_phone, t("settings.clinic.phone"), class: "field-label" %><%= f.text_field :clinic_phone, class: "input" %></div>
      <div class="field"><%= f.label :currency, t("settings.clinic.currency"), class: "field-label" %><%= f.text_field :currency, class: "input" %></div>
      <div class="field"><%= f.label :slot_minutes, t("settings.clinic.slot"), class: "field-label" %><%= f.number_field :slot_minutes, min: 15, max: 120, step: 15, class: "input" %></div>
      <div class="field"><%= f.label :week_starts_on, t("settings.clinic.week"), class: "field-label" %><%= f.select :week_starts_on, Setting::WEEK_STARTS.map { |day| [t("settings.clinic.week_#{day}"), day] }, {}, class: "select" %></div>
      <div class="field span-2">
        <%= f.label :logo, t("settings.clinic.logo"), class: "field-label" %>
        <% if @setting.logo.attached? %>
          <div class="logo-preview"><%= image_tag @setting.logo, alt: @setting.clinic_name %></div>
          <label class="field-check"><%= check_box_tag :remove_logo, "1" %><span><%= t("settings.clinic.logo_remove") %></span></label>
        <% end %>
        <%= f.file_field :logo, accept: "image/png,image/jpeg,image/webp", class: "input" %>
        <p class="field-help"><%= t("settings.clinic.logo_help") %></p>
      </div>
      <div class="field span-2 form-actions">
        <%= f.submit t("ui.save"), class: "btn btn--primary btn--sm" %>
        <%= link_to t("ui.cancel"), settings_path, class: "btn btn--ghost btn--sm" %>
      </div>
    <% end %>
  <% else %>
    <dl class="dl-meta">
      <dt><%= t("settings.clinic.name") %></dt><dd><%= @setting.clinic_name %></dd>
      <dt><%= t("settings.clinic.email") %></dt><dd><%= @setting.clinic_email.presence || "—" %></dd>
      <dt><%= t("settings.clinic.phone") %></dt><dd><%= @setting.clinic_phone.presence || "—" %></dd>
      <dt><%= t("settings.clinic.currency") %></dt><dd><%= @setting.currency %></dd>
      <dt><%= t("settings.clinic.slot") %></dt><dd><%= @setting.slot_minutes %> min</dd>
      <dt><%= t("settings.clinic.week") %></dt><dd><%= t("settings.clinic.week_#{@setting.week_starts_on}") %></dd>
      <dt><%= t("settings.clinic.logo") %></dt>
      <dd>
        <% if @setting.logo.attached? %>
          <span class="logo-preview logo-preview--sm"><%= image_tag @setting.logo, alt: @setting.clinic_name %></span>
        <% else %>
          —
        <% end %>
      </dd>
    </dl>
  <% end %>
</section>
