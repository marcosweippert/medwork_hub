<div class="page-head">
  <div>
    <h1 class="page-title"><%= t("reports.blocks") %></h1>
    <p class="page-sub"><%= @blocks.size %> blocks · <%= @recurring %> weekly · <%= @clinic_wide %> clinic-wide · <%= analytical? ? "analytical" : "synthetic" %></p>
  </div>
  <%= render "export" %>
</div>

<%= form_with url: blocks_reports_path, method: :get, class: "filter-bar no-print" do %>
  <%= render "view_field" %>
  <div class="field">
    <label class="field-label">Room</label>
    <%= select_tag :room_id, options_from_collection_for_select(@rooms, :id, :name, params[:room_id]), include_blank: t("ui.all_rooms"), class: "select" %>
  </div>
  <%= submit_tag "Apply", class: "btn btn--ghost" %>
<% end %>

<% if analytical? %>
  <section class="card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Room</th>
            <th>Reason</th>
            <th>When</th>
            <th>Weekdays</th>
          </tr>
        </thead>
        <tbody>
          <% @blocks.each do |block| %>
            <tr>
              <td class="cell-name"><%= block.room&.name || "Clinic" %></td>
              <td><%= block.label %></td>
              <td class="data-cell-mono"><%= block.starts_at.strftime("%d/%m %H:%M") %>–<%= block.ends_at.strftime("%H:%M") %></td>
              <td><%= block.recurring? ? block.weekdays_label : "—" %></td>
            </tr>
          <% end %>
          <% if @blocks.empty? %><tr><td colspan="4">No blocks configured.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%= render "summary_head" %>
<section class="kpi-grid kpi-compact">
  <article class="kpi-card"><div class="kpi-label">One-off</div><div class="kpi-value"><%= @one_off %></div></article>
  <article class="kpi-card c-primary"><div class="kpi-label">Weekly</div><div class="kpi-value"><%= @recurring %></div></article>
  <article class="kpi-card c-purple"><div class="kpi-label">Clinic-wide</div><div class="kpi-value"><%= @clinic_wide %></div></article>
</section>
