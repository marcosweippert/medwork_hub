{
  "name": "MedWork Hub · eventos",
  "nodes": [
    {
      "parameters": {
        "content": "## MedWork Hub\n\n1. Ative este workflow (Active no canto superior direito).\n2. No Webhook, copie a **Production URL**.\n3. Cole em Integrações → n8n no Hub.\n4. Slack Text: `{{ $json.slack_text }}`\n5. Switch: cada regra = `$json.event` **is equal to** (não ‘is not empty’).",
        "height": 300,
        "width": 320,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-280, 120],
      "id": "note-ajuda",
      "name": "Ajuda"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "medwork-hub",
        "responseMode": "onReceived",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [80, 280],
      "id": "webhook-medwork",
      "name": "Webhook MedWork",
      "webhookId": "medwork-hub"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' && (raw.body.event || raw.body.data) ? raw.body : raw;\nconst event = String(body.event || raw.event || 'unknown');\nconst data = body.data && typeof body.data === 'object' ? body.data : {};\nconst clinic = body.clinic || 'MedWork Hub';\n\nconst when = (iso) => {\n  if (!iso) return '';\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return String(iso);\n  return d.toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });\n};\nconst line = (label, value) => (value == null || value === '' ? null : `*${label}:* ${value}`);\nconst block = (emoji, titulo, lines) => [`${emoji} *${titulo}*`, '', ...lines.filter(Boolean), '', `_${clinic}${body.occurred_at ? ' · ' + when(body.occurred_at) : ''}_`].join('\\n');\n\nlet titulo = event;\nlet texto = '';\nlet slack_text = '';\n\nif (event === 'booking.created') {\n  titulo = 'Nova reserva';\n  texto = [data.professional, data.room, when(data.start_time)].filter(Boolean).join(' · ');\n  slack_text = block(':calendar:', titulo, [\n    line('Profissional', data.professional),\n    line('Sala', data.room),\n    line('Início', when(data.start_time)),\n    line('Fim', when(data.end_time)),\n    line('Status', data.status),\n    line('Reserva', data.id ? '#' + data.id : null),\n    line('Fatura', data.invoice_id ? '#' + data.invoice_id : null)\n  ]);\n} else if (event === 'invoice.paid') {\n  titulo = 'Fatura paga';\n  texto = [data.amount, data.professional, data.room].filter(Boolean).join(' · ');\n  slack_text = block(':white_check_mark:', titulo, [\n    line('Valor', data.amount),\n    line('Profissional', data.professional),\n    line('Sala', data.room),\n    line('Vencimento', data.due_date),\n    line('Fatura', data.id ? '#' + data.id : null)\n  ]);\n} else if (event === 'ticket.created') {\n  titulo = 'Novo chamado';\n  texto = [data.subject, data.priority, data.user].filter(Boolean).join(' · ');\n  slack_text = block(':ticket:', titulo, [\n    line('Assunto', data.subject),\n    line('Prioridade', data.priority),\n    line('Categoria', data.category),\n    line('Solicitante', data.user),\n    line('Chamado', data.id ? '#' + data.id : null)\n  ]);\n} else if (event === 'n8n.test') {\n  titulo = 'Teste de conexão';\n  texto = 'Webhook ok';\n  slack_text = block(':satellite:', titulo, ['O Hub conseguiu falar com o n8n.', line('Clínica', clinic)]);\n} else {\n  slack_text = block(':bell:', event, [line('Dados', JSON.stringify(data))]);\n}\n\nreturn [{ json: { event, clinic, occurred_at: body.occurred_at, data, titulo, texto, slack_text } }];"
      },
