<div class="page-head">
  <div>
    <h1 class="page-title"><%= @room.name %></h1>
    <p class="page-sub"><%= [@room.types_label, @room.equipment.presence].compact.join(" · ") %></p>
  </div>
  <div class="page-actions">
    <% if clinic_staff? %>
      <%= link_to "Edit", edit_room_path(@room), class: "btn btn--ghost" %>
    <% end %>
    <%= link_to "Calendar", calendar_room_path(@room), class: "btn btn--primary" %>
  </div>
</div>

<% if @room.photo.attached? %>
  <div class="room-photo">
    <%= image_tag @room.photo, alt: @room.name %>
  </div>
<% end %>

<section class="kpi-grid kpi-compact">
  <article class="kpi-card c-primary">
    <div class="kpi-label">Daily</div>
    <div class="kpi-value"><%= number_to_currency(@room.daily_rate, precision: 0) %></div>
  </article>
  <article class="kpi-card c-success">
    <div class="kpi-label">30 min</div>
    <div class="kpi-value"><%= number_to_currency(@room.slot_price) %></div>
  </article>
  <article class="kpi-card c-danger">
    <div class="kpi-label">Today</div>
    <div class="kpi-value"><%= @today_occupancy %>%</div>
  </article>
</section>

<div class="grid">
  <section class="col-7 card">
    <div class="card-head"><h2 class="card-title">Upcoming</h2></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>Professional</th><th>When</th><th>Status</th></tr></thead>
        <tbody>
          <% @upcoming_bookings.each do |booking| %>
            <tr>
              <td class="cell-name"><%= link_to booking.professional.display_name, path_with_return(booking_path(booking)), class: "table-link" %></td>
              <td class="data-cell-mono"><%= booking.start_time&.strftime("%d/%m %H:%M") %>–<%= booking.end_time&.strftime("%H:%M") %></td>
              <td><%= status_tag(booking.status) %></td>
            </tr>
          <% end %>
          <% if @upcoming_bookings.empty? %>
            <tr><td colspan="3">No upcoming holds.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="col-5 card">
    <div class="card-head">
      <h2 class="card-title">Waitlist</h2>
      <%= link_to "Manage", room_waitlist_entries_path(@room), class: "card-action" %>
    </div>
    <table class="data-table">
      <tbody>
        <% @waitlist.each do |entry| %>
          <tr>
            <td class="cell-name"><%= entry.professional.display_name %></td>
            <td class="data-cell-mono"><%= entry.starts_at.strftime("%d/%m %H:%M") %></td>
            <td><%= status_tag(entry.status) %></td>
          </tr>
        <% end %>
        <% if @waitlist.empty? %><tr><td colspan="3">Nobody waiting. Occupied hours on the calendar open join waitlist.</td></tr><% end %>
      </tbody>
    </table>
  </section>

  <% if clinic_staff? %>
  <section class="col-12 card">
    <div class="card-head">
      <h2 class="card-title">Blocks</h2>
      <%= link_to "All blocks", room_blocks_path, class: "card-action" %>
    </div>
    <%= form_with model: [@room, @block], class: "form-grid" do |f| %>
      <div class="field">
        <%= f.label :starts_at, class: "field-label" %>
        <%= f.datetime_local_field :starts_at, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :ends_at, class: "field-label" %>
        <%= f.datetime_local_field :ends_at, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :reason, class: "field-label" %>
        <%= f.text_field :reason, class: "input", placeholder: "Maintenance, holiday…" %>
      </div>
      <div class="field">
        <span class="field-label">Repeat weekly</span>
        <%= render "shared/weekday_checks", name: "room_block[weekdays]", selected: @block.weekdays, short: true %>
      </div>
      <div class="field span-2">
        <%= f.submit "Block", class: "btn btn--primary btn--sm" %>
      </div>
    <% end %>
    <table class="data-table" style="margin-top:12px;">
      <tbody>
        <% (@blocks + @clinic_blocks).uniq.each do |block| %>
          <tr>
            <td><%= block.label %><% if block.clinic_wide? %> · all rooms<% end %></td>
            <td class="data-cell-mono">
              <% if block.recurring? %>
                <%= block.weekdays_label %> <%= block.starts_at.strftime("%H:%M") %>–<%= block.ends_at.strftime("%H:%M") %>
              <% else %>
                <%= block.starts_at.strftime("%d/%m %H:%M") %>–<%= block.ends_at.strftime("%d/%m %H:%M") %>
              <% end %>
            </td>
            <td class="cell-actions"><%= button_to "Remove", room_block_path(block), method: :delete, class: "btn btn--chip btn--danger" %></td>
          </tr>
        <% end %>
        <% if @blocks.empty? && @clinic_blocks.empty? %>
          <tr><td colspan="3">No upcoming blocks.</td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <% end %>
</div>
