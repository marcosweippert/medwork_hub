<section class="invoice-hero">
  <div class="page-head" style="margin:0;">
    <div>
      <p class="page-sub"><%= Date.current.strftime("%d/%m/%Y") %></p>
      <h1 class="page-title"><%= dashboard_greeting %></h1>
    </div>
    <div class="page-actions">
      <%= link_to t("dashboards.new_booking"), new_booking_path, class: "btn btn--primary" %>
      <%= link_to t("tickets.create"), new_ticket_path, class: "btn btn--ghost" %>
    </div>
  </div>
</section>

<div class="fin-kpis">
  <%= link_to revenue_reports_path, class: "fin-kpi" do %>
    <p class="label"><%= t("dashboards.paid_month") %></p>
    <strong><%= number_to_currency(@revenue_month, precision: 0) %></strong>
    <p class="delta"><%= @revenue_delta.to_f >= 0 ? "+" : "" %><%= @revenue_delta %>% <%= t("dashboards.vs_last_month") %></p>
  <% end %>
  <%= link_to invoices_path, class: "fin-kpi" do %>
    <p class="label"><%= t("dashboards.receivables") %></p>
    <strong><%= number_to_currency(@open_amount, precision: 0) %></strong>
    <p class="page-sub" style="margin-top:6px;"><%= t("dashboards.open_receivables") %></p>
  <% end %>
  <%= link_to invoices_path(status: "overdue"), class: "fin-kpi" do %>
    <p class="label"><%= t("dashboards.overdue").capitalize %></p>
    <strong><%= @overdue_count %></strong>
    <p class="page-sub" style="margin-top:6px;"><%= t("nav.invoices") %></p>
  <% end %>
  <%= link_to tickets_path(tab: "pending"), class: "fin-kpi" do %>
    <p class="label"><%= t("tickets.open_queue") %></p>
    <strong><%= @open_tickets %></strong>
    <p class="page-sub" style="margin-top:6px;"><%= t("tickets.sla_breached") %>: <%= @breached_tickets %></p>
  <% end %>
</div>

<div class="grid">
  <section class="col-8 card">
    <div class="card-head">
      <h2 class="card-title"><%= t("dashboards.recent_transactions") %></h2>
      <%= link_to t("dashboards.all"), invoices_path, class: "card-action" %>
    </div>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t("transactions.order") %></th>
            <th><%= t("ui.professional") %></th>
            <th class="cell-price"><%= t("transactions.amount") %></th>
            <th><%= t("transactions.date") %></th>
            <th><%= t("ui.status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @recent_payments.each do |invoice| %>
            <tr>
              <td class="data-cell-mono"><%= link_to "##{invoice.id.to_s.rjust(4, "0")}", invoice_path(invoice), class: "table-link" %></td>
              <td class="cell-name"><%= invoice.professional.display_name %></td>
              <td class="cell-price"><%= number_to_currency(invoice.collected_amount) %></td>
              <td class="data-cell-mono"><%= invoice.paid_at&.strftime("%d/%m/%Y") %></td>
              <td><%= status_tag(invoice.status) %></td>
            </tr>
          <% end %>
          <% if @recent_payments.empty? %>
            <tr><td colspan="5"><%= t("dashboards.empty_upcoming") %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
  <section class="col-4 card">
    <div class="card-head">
      <h2 class="card-title"><%= t("dashboards.featured_rooms") %></h2>
      <%= link_to t("dashboards.all"), rooms_path, class: "card-action" %>
    </div>
    <% @hot_rooms.each do |room, occ| %>
      <%= link_to calendar_room_path(room), class: "hz-widget", style: "margin-bottom:8px;box-shadow:none;background:var(--bg-muted);" do %>
        <div>
          <strong style="font-size:15px;"><%= room.name %></strong>
          <p><%= room.types_label %></p>
        </div>
        <strong><%= occ %>%</strong>
      <% end %>
    <% end %>
  </section>
</div>
